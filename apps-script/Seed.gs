/**
 * بيانات البداية — تُشغَّل مرة واحدة.
 *
 * الاستخدام: اختر الدالة seedAll من القائمة واضغط Run.
 * آمنة: لو التبويب فيه بيانات بالفعل بتتخطاه ولا بتكرر أي صف.
 *
 * تولّد آليًا من:
 *   context/mosques.csv      — 85 مسجد
 *   context/khatibs.csv      — 131 خطيب
 *   context/preferences.csv  — 2458 تفضيل
 *
 * ملاحظتان:
 *   - رقم الهاتف فاضي للجميع، يتدخل يدويًا من شاشة الخطباء.
 *   - كل الخطباء يبدأون كـ primary (أساسي). غيّر النوع من الشاشة
 *     لمن هو متطوع — الفرق للعرض والتصفية فقط، لا يؤثر على التوزيع.
 */

function seedAll() {
  var report = [];
  report.push(seedMosques_());
  report.push(seedKhatibs_());
  report.push(seedPreferences_());

  var msg = report.join('\n');
  Logger.log(msg);
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) {}
  return msg;
}

function seedMosques_() {
  var sh = SpreadsheetApp.getActive().getSheetByName('mosques');
  if (!sh) return 'المساجد: التبويب غير موجود — شغّل setup أولاً';
  if (sh.getLastRow() > 1) return 'المساجد: فيها ' + (sh.getLastRow() - 1) + ' صف بالفعل — تم التخطي';

  var now = new Date().toISOString();
  var rows = SEED_MOSQUES.map(function (m) {
    return [m[0], m[1], m[2], '', '', 'TRUE', now];
  });
  writeSeed_(sh, 'mosques', rows);
  return 'المساجد: تم إدخال ' + rows.length;
}

function seedKhatibs_() {
  var sh = SpreadsheetApp.getActive().getSheetByName('khatibs');
  if (!sh) return 'الخطباء: التبويب غير موجود — شغّل setup أولاً';
  if (sh.getLastRow() > 1) return 'الخطباء: فيها ' + (sh.getLastRow() - 1) + ' صف بالفعل — تم التخطي';

  var now = new Date().toISOString();
  var rows = SEED_KHATIBS.map(function (k) {
    return [k[0], k[1], '', 'primary', '', 'TRUE', now];
  });
  writeSeed_(sh, 'khatibs', rows);
  return 'الخطباء: تم إدخال ' + rows.length;
}

function seedPreferences_() {
  var sh = SpreadsheetApp.getActive().getSheetByName('preferences');
  if (!sh) return 'التفضيلات: التبويب غير موجود — شغّل setup أولاً';
  if (sh.getLastRow() > 1) return 'التفضيلات: فيها ' + (sh.getLastRow() - 1) + ' صف بالفعل — تم التخطي';

  var rows = [];
  for (var k in SEED_PREFS) {
    SEED_PREFS[k].split(',').forEach(function (m) { rows.push([k, m]); });
  }
  writeSeed_(sh, 'preferences', rows);
  return 'التفضيلات: تم إدخال ' + rows.length + ' لـ ' + Object.keys(SEED_PREFS).length + ' خطيب';
}

/** كتابة دفعة واحدة ثم إعادة فرض تنسيق النص — نفس قاعدة Code.gs. */
function writeSeed_(sh, tab, rows) {
  if (!rows.length) return;
  sh.getRange(2, 1, rows.length, rows[0].length).setValues(rows);
  applyTextFormat_(sh, tab, 2, rows.length);
}

